{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ratmail",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // The web app. /api/* goes to the Worker; everything else is a static file.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Sessions and UI preferences only (see schema.sql). No mail is stored.
  // Create with: npx wrangler d1 create ratmail, paste the id here, then npm run db:init
  "d1_databases": [
    { "binding": "DB", "database_name": "ratmail", "database_id": "REPLACE_WITH_D1_ID" }
  ],
  // Optional: override config/servers.json without editing it, e.g. in .dev.vars:
  // SERVERS_JSON='{"servers":[...]}'
  "observability": { "enabled": true }
}
