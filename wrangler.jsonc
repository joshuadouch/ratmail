{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ratmail",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Served only on the custom domain (HTTPS is needed for the session cookie).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ratmail.ratlan.net", "custom_domain": true }, { "pattern": "webmail.ratlan.net", "custom_domain": true }],
  // The web app. /api/* goes to the Worker; everything else is a static file.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Sessions and UI preferences only (see schema.sql). No mail is stored.
  // Your own deploy: npx wrangler d1 create ratmail, paste its id here, then npm run db:init
  "d1_databases": [
    { "binding": "DB", "database_name": "ratmail", "database_id": "25f054d8-2c85-4c4e-b15c-197d2b353a7e" }
  ],
  // Optional: override config/servers.json without editing it, e.g. in .dev.vars:
  // SERVERS_JSON='{"servers":[...]}'
  "observability": { "enabled": true }
}
